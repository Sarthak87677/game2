# Terra Infinite — optional credentials. The app runs fully without any of these (demonstration mode).
# Copy this file to .env and fill in only the keys you have. Never commit .env.

# Cesium ion access token (https://ion.cesium.com/). Enables Cesium World Terrain, Bing/Sentinel-2 imagery
# and Cesium OSM Buildings. Free tier available. Leave empty to use the open AWS Terrarium terrain + open imagery.
VITE_CESIUM_ION_TOKEN=

# MapTiler API key (https://www.maptiler.com/). Optional higher-quality satellite imagery and terrain-RGB tiles.
VITE_MAPTILER_KEY=

# Override the imagery provider used at startup: procedural | osm | esri | gibs | maptiler | ion
VITE_DEFAULT_IMAGERY=

# Override the terrain provider used at startup: terrarium | ion | maptiler | ellipsoid
VITE_DEFAULT_TERRAIN=

# Overpass API endpoint for OpenStreetMap feature streaming (public default has strict fair-use limits).
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Geocoding endpoint (Nominatim-compatible). Public default has a 1 request/second policy.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Live weather adapter (Open-Meteo, no key required). Set to "false" to disable network weather entirely.
VITE_ENABLE_LIVE_WEATHER=true

# Comma-separated list of networked adapters to disable, e.g. "osm,nominatim" for fully offline demos.
VITE_DISABLED_ADAPTERS=
